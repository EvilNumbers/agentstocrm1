# Шаблон без личных данных. Запустите setup.bat: мастер создаст собственный .env.
# Никогда не отправляйте свой .env другим людям.
STOCRM_DOMAIN=
STOCRM_SID=
STOCRM_MOCK=0
STOCRM_STATE_DIR=.state

TG_BOT_TOKEN=
TG_ALLOWED_USERS=
TG_ADMIN_USERS=
TG_CONFIRM_REQUIRED=1
TG_POLICY_PATH=.state/bot_policy.json

# Google AI Studio — модель; Groq — распознавание русской речи.
LLM_PROVIDER=google
LLM_API_KEY=
STT_PROVIDER=groq
STT_API_KEY=
STT_LANGUAGE=ru

# Росско — опционально. Только GetSearch, заказ через бота запрещён.
# Пробно без ID: Росско может отклонить запрос, т.к. API требует ID доставки.
# Не отправляйте .env, ключи и личные настройки никому.
ROSSKO_ENABLED=0
ROSSKO_KEY1=
ROSSKO_KEY2=
ROSSKO_DELIVERY_ID=
ROSSKO_ADDRESS_ID=
